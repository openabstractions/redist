#!/bin/sh
# Package preflight runs before payload replacement. The package scripts carry
# the helper so an older installed helper cannot weaken this stop requirement.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$here/lifecycle.sh"
home=${HOME:-}
case "$home" in /*) ;; *) home=${2:-};; esac
[ -n "$home" ] || { echo "preinstall: target user home required" >&2; exit 1; }
home=$(CDPATH= cd -- "$home" && pwd -P)
[ "$home" != / ] || { echo "preinstall: target must be a user home" >&2; exit 1; }
# Installer may also supply an installation target. A plausible user-owned
# target must agree with HOME before any supervisor is observed or stopped.
# The normal component root '/' does not identify a competing user home.
target=${2:-}
case "$target" in
    /*)
        if [ "$target" != / ] && [ -d "$target" ]; then
            target=$(CDPATH= cd -- "$target" && pwd -P)
            target_uid=$(stat -f %u "$target")
            case "$target_uid" in
                ''|*[!0-9]*) echo "preinstall: target owner unavailable" >&2; exit 1;;
                0) ;;
                *) [ "$target" = "$home" ] || {
                    echo "preinstall: conflicting user-home targets; replacement refused" >&2
                    exit 1
                };;
            esac
        fi;;
esac
uid=$(stat -f %u "$home")
case "$uid" in ''|*[!0-9]*|0) echo "preinstall: non-root target owner required" >&2; exit 1;; esac
# postinstall must rename a plist into LaunchAgents after the package payload
# lands. Check the existing destination (or the parent mkdir will use) as the
# target user now, before stopping a predecessor or replacing its files. Root's
# own -w result would accept a root-owned 0755 directory that the user cannot
# modify. Leave existing directory ownership and permissions to the owner.
agents=$home/Library/LaunchAgents
for dir in "$home/Library" "$agents"; do
    if [ -e "$dir" ] || [ -L "$dir" ]; then
        [ -d "$dir" ] && [ ! -L "$dir" ] || {
            echo "preinstall: unsafe LaunchAgents ancestor: $dir" >&2
            exit 1
        }
    fi
done
writable=$agents
[ -d "$writable" ] || writable=$home/Library
[ -d "$writable" ] || writable=$home
installer_uid=$(id -u)
if [ "$installer_uid" = "$uid" ]; then
    target_can_write=no
    if [ -w "$writable" ] && [ -x "$writable" ]; then target_can_write=yes; fi
elif [ "$installer_uid" = 0 ]; then
    target_can_write=no
    if sudo -n -u "#$uid" /bin/test -w "$writable" &&
       sudo -n -u "#$uid" /bin/test -x "$writable"; then target_can_write=yes; fi
else
    echo "preinstall: installer must run as the target user or root" >&2
    exit 1
fi
[ "$target_can_write" = yes ] || {
    echo "preinstall: LaunchAgents destination is not writable by target user: $writable; fix ownership or permissions and retry" >&2
    exit 1
}
# Select and verify the target user's GUI bootstrap. A home-domain install runs
# this script as that user; asuser names the target domain explicitly.
manager print "gui/$uid" >/dev/null
manager_uid=$(manager asuser "$uid" /bin/launchctl manageruid)
manager_name=$(manager asuser "$uid" /bin/launchctl managername)
[ "$manager_uid" = "$uid" ] && [ "$manager_name" = Aqua ] || {
    echo "preinstall: target graphical login session unavailable; replacement refused" >&2
    exit 1
}
agent_state() {
    jobs=$(manager asuser "$uid" /bin/launchctl list) || return 1
    printf '%s\n' "$jobs" | awk -v label="$1" '
        NR == 1 { if (NF != 3 || $1 != "PID" || $2 != "Status" || $3 != "Label") bad=1; next }
        NF < 3 || $1 !~ /^(-|[0-9]+)$/ || $2 !~ /^-?[0-9]+$/ { bad=1 }
        NF == 3 && $3 == label { found=1 }
        END { if (bad || NR == 0) exit 2; print found ? "present" : "absent" }
    '
}
# 0.1.7 and earlier registered the same runtime as com.openabstractions.jobd.
# All three labels are booted out and verified absent before any file is
# replaced: a running Panel holds its own executable open, the same reason
# the runtime is booted out before its payload is replaced.
for label in com.openabstractions.jobd com.openabstractions.runtime com.openabstractions.panel; do
    state=$(agent_state "$label")
    booted=no
    if [ "$state" = present ]; then
        manager bootout "gui/$uid/$label"
        booted=yes
        state=$(agent_state "$label")
    fi
    [ "$state" = absent ] || {
        echo "preinstall: previous LaunchAgent $label remains registered; replacement refused" >&2
        exit 1
    }
    if [ "$booted" = yes ]; then
        echo "ok    booted out running previous LaunchAgent gui/$uid/$label; absence verified before replacement; graceful exit is not independently established"
    else
        echo "ok    no previous LaunchAgent $label registered in gui/$uid; nothing booted out before replacement"
    fi
done
