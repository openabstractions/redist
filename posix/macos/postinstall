#!/bin/sh
# Runs after the payload lands. A home-domain install uses authorization level
# none: Installer starts a per-user installd and package_script_service, and
# this script runs as the installing user with no password (observed on macOS
# 26.6.2 25G83, 2026-09-15). The payload is rooted at that person's home
# directory. This script turns home-relative facts into absolute ones and
# registers the LaunchAgent in that person's gui/<uid> domain.
set -eu
umask 022

home=${HOME:-}
case "$home" in
/*) ;;
*) home=$2 ;;
esac
home=$(CDPATH= cd -- "$home" && pwd -P)
[ "$home" != / ] || { echo "postinstall: target must be a user home" >&2; exit 1; }
share=$home/.local/share/abstraction
bin=$home/.local/bin
# The payload carries the plist as a template in the share directory. Only the
# finished file ever appears in ~/Library/LaunchAgents: it is written under a
# temporary name outside that directory, then renamed into place on the same
# volume, so Background Task Management never reads the @BIN@ placeholder.
template=$share/com.openabstractions.runtime.plist
agents=$home/Library/LaunchAgents
plist=$agents/com.openabstractions.runtime.plist

uid=$(stat -f %u "$home")
gid=$(stat -f %g "$home")

[ -f "$template" ] || { echo "postinstall: LaunchAgent template missing" >&2; exit 1; }
# Refuse an unsafe existing ancestor before changing the registration or its
# ownership. Some of these directories can contain unrelated user files, so
# tightening their permissions here would be an unexpected side effect.
check_existing_dir() {
    dir=$1
    [ -e "$dir" ] || return 0
    [ -d "$dir" ] && [ ! -L "$dir" ] || { echo "postinstall: unsafe payload directory: $dir" >&2; exit 1; }
    [ "$(stat -f %u "$dir")" = "$uid" ] || { echo "postinstall: foreign payload directory: $dir" >&2; exit 1; }
    permissions=$(stat -f %Lp "$dir")
    case "$permissions" in *[!0-7]*|'') echo "postinstall: cannot inspect directory permissions: $dir" >&2; exit 1;; esac
    [ $((0$permissions & 0022)) -eq 0 ] || {
        echo "postinstall: unsafe writable directory: $dir; run chmod go-w '$dir' and retry" >&2
        exit 1
    }
}
for dir in "$home" "$home/.local" "$bin" "$home/.local/share" "$share" "$home/Library" "$agents"; do
    check_existing_dir "$dir"
done
. "$share/lifecycle.sh"
mkdir -p -- "$agents"
for label in com.openabstractions.runtime-login com.openabstractions.panel; do
    login_trigger_check "$label" || { echo "postinstall: login trigger ownership refused" >&2; exit 1; }
done
tmp=$(mktemp "$share/.com.openabstractions.runtime.plist.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT
# Escape XML text first, then escape sed replacement metacharacters.
replacement=$(printf '%s' "$bin" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' | sed 's/[\\&|]/\\&/g')
sed "s|@BIN@|$replacement|g" "$template" > "$tmp"
if grep -q '@BIN@' "$tmp"; then echo "postinstall: LaunchAgent placeholder left unsubstituted" >&2; exit 1; fi
chmod 644 "$tmp"
mv -f -- "$tmp" "$plist"
trap - EXIT

# Login triggers are created only by the runtime's confirmed-Applications
# coordinator. The package records their fixed paths before that first start.
# Existing owned triggers can survive a quiescent upgrade; foreign bytes refuse.
panel_plist=$agents/com.openabstractions.panel.plist
login_plist=$agents/com.openabstractions.runtime-login.plist

# Exact predecessor package bytes only, including its LF and CRLF forms.
# Changed endpoint records belong to the person and remain untouched.
retired_default_host() {
    case "$1:$2" in
        comfyui.json:3ea792ffa92b857fd72560562894b080e9d63cfd48d3bb0a489adba9d7ec48c6|comfyui.json:5e2b293cad42b4f1df5c30b39a5f19d56a868eb29ba0bbea3d0e47c2cfdb43d2) return 0;;
        lemonade.json:beb97c82132d806cd9ce18381a8590399ea283a75e5b0ebffb129303e4a0ca2c|lemonade.json:28ea4da85a22e35932b1a18d60b1157a8df1ca6fcec1cd832ed6f2de93058e6d) return 0;;
        lmstudio.json:b4e0808006e2494577db016219f02d302096f7c22ec4ed5afb53792c2650a885|lmstudio.json:8ab6e76b9a52bd6d9418a2d5e8fb702707f4ef5e44c1f608b16f0b9ac44f80ce) return 0;;
        ollama.json:37890f65cdd55fb0162104ebc718d5fafd5995afe13a4d5d5cc7bbc81068628b|ollama.json:80b9f420b68f5c4feb72a46ed73b04754cd266c979190a274a6ae884af4e1594) return 0;;
    esac
    return 1
}

# 0.1.7 and earlier installed jobd, dl and jobctl and registered the runtime as
# com.openabstractions.jobd (docs/REMOVED.md). preinstall booted that label out.
# Its plist would start a second runtime at the next login, so each retired
# file the predecessor's MANIFEST lists is removed before the new ledger exists.
# 0.3.0 also installed the localstores and modelhost features; native providers
# are not available on macOS in 0.4.0 (their caller check needs an XPC
# endpoint), and a declaration left behind would name a provider that stops at
# startup.
if [ -f "$share/MANIFEST" ]; then
    check_existing_dir "$bin/declarations"
    for name in comfyui lemonade lmstudio ollama; do
        retired=$bin/declarations/$name.json
        rel=.local/bin/declarations/$name.json
        if grep -F -x -- "$retired" "$share/MANIFEST" >/dev/null &&
            ! grep -F -x -- "$rel" "$share/FILES" >/dev/null &&
            [ -f "$retired" ] && [ ! -L "$retired" ]; then
            digest=$(shasum -a 256 < "$retired")
            if retired_default_host "$name.json" "${digest%% *}"; then
                rm -f -- "$retired"
                echo "ok    removed retired default $retired"
            fi
        fi
    done
    for retired in "$agents/com.openabstractions.jobd.plist" "$share/com.openabstractions.jobd.plist" \
        "$bin/jobd" "$bin/dl" "$bin/jobctl" \
        "$bin/inventoryd" "$bin/declarations/local-stores.json" "$bin/modelhostd"; do
        if grep -F -x -- "$retired" "$share/MANIFEST" >/dev/null && [ -f "$retired" ] && [ ! -L "$retired" ]; then
            rm -f -- "$retired"
            echo "ok    removed retired $retired"
        fi
    done
fi

# FILES names every file this package could install, the optional features of
# VISION 2026-09-22 included. Each of those is its own component package and
# its own choice, installed before this one, so a path that is not on disk now
# is a choice the person did not take and belongs in no removal ledger.
manifest_tmp=$share/MANIFEST.new
: > "$manifest_tmp"
while read -r rel; do
	[ -n "$rel" ] || continue
	[ -e "$home/$rel" ] || continue
	echo "$home/$rel" >> "$manifest_tmp"
done < "$share/FILES"
echo "$plist" >> "$manifest_tmp"
echo "$login_plist" >> "$manifest_tmp"
echo "$login_plist.lock" >> "$manifest_tmp"
echo "$panel_plist" >> "$manifest_tmp"
echo "$panel_plist.lock" >> "$manifest_tmp"
mv -f -- "$manifest_tmp" "$share/MANIFEST"

# Restore ownership along each installed path. This walks
# ancestors only; unrelated siblings in ~/.local/bin or Library stay untouched.
own_path() {
    installed=$1
    case "$installed" in "$home"/*) ;; *) echo "postinstall: path outside target home" >&2; exit 1;; esac
    case "$installed" in */../*|*/..|*/./*) echo "postinstall: noncanonical payload path" >&2; exit 1;; esac
    [ ! -L "$installed" ] || { echo "postinstall: symlink payload refused" >&2; exit 1; }
    dir=${installed%/*}
    while [ "$dir" != "$home" ]; do
        [ -d "$dir" ] && [ ! -L "$dir" ] || { echo "postinstall: unsafe payload directory" >&2; exit 1; }
        dir=${dir%/*}
    done
    chown "$uid:$gid" "$installed"
    dir=${installed%/*}
    while [ "$dir" != "$home" ]; do
        chown "$uid:$gid" "$dir"
        dir=${dir%/*}
    done
}
while IFS= read -r installed; do
    case "$installed" in "$login_plist"|"$panel_plist"|"$login_plist.lock"|"$panel_plist.lock") [ -e "$installed" ] || continue;; esac
    own_path "$installed"
done < "$share/MANIFEST"
own_path "$share/MANIFEST"

domain=gui/$uid
service=$domain/com.openabstractions.runtime
# A failed manager query/registration is an installation error. The plist remains
# available for the user to register later in a graphical login session.
manager print "$domain" >/dev/null
if manager print "$service" >/dev/null 2>&1; then
    manager bootout "$service"
fi
manager enable "$service"
manager bootstrap "$domain" "$plist"
manager print "$service" >/dev/null
echo "ok    shared runtime LaunchAgent registered for this user; capability identity proof remains separately required"

# One package-owned activation initializes the existing Applications watcher.
# start owns the selected-installation and GUI-session checks and its deadline.
# No installer reads application state or creates unconditional login triggers.
if [ "$(id -u)" = "$uid" ]; then
    "$bin/openabstractions" start --timeout 20s
else
    sudo -n -u "#$uid" "$bin/openabstractions" start --timeout 20s
fi
for label in com.openabstractions.runtime-login com.openabstractions.panel; do
    login_trigger_check "$label" || { echo "postinstall: reconciled login trigger ownership refused" >&2; exit 1; }
done
echo "ok    Applications login policy initialized; next-login behavior requires installed receiving"
exit 0
