<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Abstraction"
           Manufacturer="Open Abstractions"
           Version="$(var.Version)"
           UpgradeCode="CEEF6550-5E44-4E83-8E18-A855C9D941CA"
           Scope="perUserOrMachine"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="Downloads that survive the program that started them" />

    <!-- The predecessor is removed after this installation is committed.
         Inside the transaction, a failure rolls the removal back, and an
         unelevated per-user rollback is denied the HKLM registration it would
         have to rewrite: the predecessor came back as files with no product
         registration, no Apps and features entry and no way to restart it. After
         InstallFinalize the predecessor is untouched until this version is
         committed, so any failure before that leaves the previous version
         installed, registered and runnable — the owner's ruling of
         2026-09-16. The price is a second transaction: if the predecessor's
         own uninstall fails, both products stay installed
         (https://learn.microsoft.com/en-us/windows/win32/msi/removeexistingproducts-action). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallFinalize"
                  DowngradeErrorMessage="A newer Abstraction is already installed. Remove it from Apps and features before installing this one." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/openabstractions" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <!-- Native GUI session handling closes the per-user supervisor and its
         contained runtime. Keep graceful Restart Manager shutdown enabled. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="0" />
    <Property Id="MSIRMSHUTDOWN" Value="0" />
    <!-- AdminUser reports the installing token itself. Without this, Windows sets
         AdminUser wherever Privileged is set, including AlwaysInstallElevated for
         a standard user, whose per-user activation works. -->
    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />
    <SetProperty Id="MSIDISABLERMRESTART" Value="1" Before="InstallValidate" Sequence="execute"
                 Condition="NOT ALLUSERS AND REMOVE=&quot;ALL&quot;" />

    <!-- A build that was not handed a source drops the files it would have
         carried, and every one of those drops is silent: build.py prints a
         note, the package says nothing, and a person reads feature text
         written for a package that has more in it. That is the per-user
         fallback one layer down — an artefact quietly doing less than it
         promised — so each gate turns the same variable into a sentence a
         person reads in Apps and features. An incomplete package may ship;
         one that does not say it is incomplete may not. -->
    <?if $(var.Panel) = yes ?><?define NoPanel = "" ?>
    <?else?><?define NoPanel = " The Abstraction Panel, the graphical front end, is not in it." ?><?endif?>
    <?if $(var.Cpp) = yes ?><?define NoCpp = "" ?>
    <?else?><?define NoCpp = " The C++ header is not in it; no module carries it." ?><?endif?>
    <?if $(var.LocalStores) = yes ?><?define NoLocalStores = "" ?>
    <?else?><?define NoLocalStores = " The local model stores feature is not in it; abstraction-storage-over-local-stores publishes nowhere yet, so this build could not obtain inventoryd." ?><?endif?>
    <?if $(var.ModelHost) = yes ?><?define NoModelHost = "" ?>
    <?else?><?define NoModelHost = " The model host feature is not in it; abstraction-provider-modelhost publishes nowhere yet, so this build could not obtain modelhostd." ?><?endif?>
    <?if $(var.McpGateway) = yes ?><?define NoMcpGateway = "" ?>
    <?else?><?define NoMcpGateway = " The MCP gateway feature is not in it; this build was given no source or binary for openabstractions-mcp." ?><?endif?>
    <?define Absent = "$(var.NoPanel)$(var.NoCpp)$(var.NoLocalStores)$(var.NoModelHost)$(var.NoMcpGateway)" ?>
    <?if $(var.Absent) = "" ?>
    <Property Id="ARPCOMMENTS" Value="Downloads that survive the program that started them." />
    <?else?>
    <Property Id="ARPCOMMENTS" Value="This build is incomplete and says so.$(var.Absent)" />
    <?endif?>
    <Property Id="ApplicationFolderName" Value="OpenAbstractions" />
    <Property Id="WixAppFolder" Value="WixPerUserFolder" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[APPLICATIONFOLDER]" After="CostFinalize" />

    <!-- WixUI_Advanced defaults these to LocalAppData\Apps and to the 32-bit
         Program Files. Programs\ is where a per-user application goes on a
         modern Windows, and an x64 package under Program Files (x86) is a lie
         about what is inside it.

         ProgramFiles64Folder and not ProgramFiles6432Folder: the 6432 spelling
         is resolved by the compiler where a Directory is declared and means
         nothing inside a property value, where it expands to the empty string
         and leaves a bare relative folder name. Both architectures this
         package is built for are 64-bit. -->
    <SetProperty Action="AbstractionPerUserFolder" Id="WixPerUserFolder"
                 Value="[LocalAppDataFolder]Programs\[ApplicationFolderName]"
                 After="WixSetDefaultPerUserFolder" Sequence="both" />
    <SetProperty Action="AbstractionPerMachineFolder" Id="WixPerMachineFolder"
                 Value="[ProgramFiles64Folder][ApplicationFolderName]"
                 After="WixSetDefaultPerMachineFolder" Sequence="both" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="APPLICATIONFOLDER" Name="OpenAbstractions">
          <Directory Id="ToolsFolder" Name="tools">
            <!-- The declaration files the installation places beside the
                 runtime executable. The runtime reads them at start and lists
                 them as declared by the installation; an operator's removal
                 of one is recorded in the runtime's own state, so this
                 package writing the file again does not bring it back. -->
            <Directory Id="DeclarationsFolder" Name="declarations" />
          </Directory>
          <Directory Id="ExamplesFolder" Name="examples">
            <Directory Id="ExampleMachine" Name="what-this-machine-does" />
            <Directory Id="ExampleLifecycle" Name="job-lifecycle" />
            <Directory Id="ExampleDownload" Name="download-a-file" />
          </Directory>
          <Directory Id="DevFolder" Name="dev">
            <Directory Id="DevInclude" Name="include">
              <Directory Id="DevIncludeAbstraction" Name="abstraction">
                <Directory Id="DevIncludeDownload" Name="download" />
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AbstractionMenuFolder" Name="Abstraction" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="MachineConfigFolder" Name="abstraction">
        <Directory Id="MachineUpgradeFolder" Name="upgrade-v1" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="StartupFolder" />

    <!-- openabstractions.exe is the console command a person types and the
         runtime the host supervises; openabstractionsw.exe is the same serve
         source linked -H=windowsgui, the image the service template, the
         Startup shortcut and the post-install activation run, because a
         console image started at sign-in opens a console window.

         Nothing about the registration depends on the folder: the custom
         actions reach the files through the File table by Id, and the
         service's ImagePath is written by `host register` from its own
         os.Executable(). -->
    <ComponentGroup Id="ServiceFiles">
      <Component Directory="ToolsFolder">
        <File Id="openabstractions.exe" Source="payload/tools/openabstractions.exe" KeyPath="yes" />
        <!-- Restart Manager ends only the processes holding a file this
             transaction replaces or removes. A 0.1.5-0.1.7 predecessor runs its
             runtime under jobdw.exe (or jobd.exe), which this package no longer
             carries, so without these rows Restart Manager sees only the
             runtime child openabstractions.exe. It cannot shut down that
             console-type process (RmShutdown returns ERROR_FAIL_SHUTDOWN after
             30 s), the replacement of openabstractions.exe fails with 1310 and
             the upgrade ends 1603. Removing the predecessor's supervisor image
             in this transaction registers it: Restart Manager sends its hidden
             window WM_QUERYENDSESSION, and the supervisor ends its contained
             runtime. A rollback
             restores the files, and the predecessor's own late removal finds
             them already gone. -->
        <RemoveFile Id="RemovePredecessorJobdw" Directory="ToolsFolder" Name="jobdw.exe" On="install" />
        <RemoveFile Id="RemovePredecessorJobd" Directory="ToolsFolder" Name="jobd.exe" On="install" />
      </Component>
      <Component Directory="ToolsFolder">
        <File Id="openabstractionsw.exe" Source="payload/tools/openabstractionsw.exe" KeyPath="yes" />
      </Component>
      <Component Directory="DeclarationsFolder">
        <File Id="declaration.lemonade.json" Source="payload/tools/declarations/lemonade.json" KeyPath="yes" />
      </Component>
      <Component Directory="DeclarationsFolder">
        <File Id="declaration.lmstudio.json" Source="payload/tools/declarations/lmstudio.json" KeyPath="yes" />
      </Component>
      <Component Directory="DeclarationsFolder">
        <File Id="declaration.ollama.json" Source="payload/tools/declarations/ollama.json" KeyPath="yes" />
      </Component>
      <Component Directory="DeclarationsFolder">
        <File Id="declaration.comfyui.json" Source="payload/tools/declarations/comfyui.json" KeyPath="yes" />
      </Component>
      <Component Id="RegistryRoot" Directory="APPLICATIONFOLDER"
                 Guid="8821E881-5E73-465E-904E-EF7FC1223A5C">
        <RegistryValue Root="HKMU" Key="Software\OpenAbstractions\Abstraction"
                       Name="version" Type="string" Value="$(var.Version)" KeyPath="yes" />
        <RemoveRegistryKey Root="HKMU" Key="Software\OpenAbstractions" Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>

    <!-- Registering the host is a machine-scope act: the SCM is what
         supervises a process on Windows and reaching it needs an administrator
         token. A SERVICE_USER_OWN_PROCESS template is cloned into every
         interactive session as `<name>_<luid>`, running as that person with no
         password stored, and restarted when it fails (VISION.md 2026-09-10
         "Host S is unnecessary"). WiX's ServiceInstall cannot express that
         type, so `openabstractions host register` writes it from a deferred
         custom action, and `host unregister` deletes the template and the
         per-session instances that outlive it.

         Every one of these is conditioned on ALLUSERS. A per-user install has
         no administrator token.

         The package stops nothing.
         Restart Manager ends the running host at InstallValidate: per-user
         through its session window, machine scope through the SCM. The host
         registers for restart, and every restart path below is an idempotent
         activation, correct whether or not anything was running. -->
    <Binary Id="UpgradeSupervisorCode" SourceFile="payload/tools/openabstractions.exe" />
    <!-- Upgrade exclusion. The incoming openabstractions records the folders
         being replaced and this installer process; every activation path of
         those folders (start, serve host, SDK activation) exits 3 while the
         installer lives. The commit action releases it. The rollback action
         releases it and runs the previous version's own activation. Order in
         the early script, per scope: begin, commit release, rollback
         activation. Rollback runs in reverse, so the record is released and
         the previous runtime activated after the files are back. The early
         InstallExecute flushes the chain before any file is replaced. -->

    <CustomAction Id="BeginMachineUpgradeExclusion" BinaryRef="UpgradeSupervisorCode"
                  ExeCommand="service begin-upgrade --machine &quot;[APPLICATIONFOLDER].&quot; --related &quot;[WIX_UPGRADE_DETECTED]&quot;"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="EndMachineUpgradeExclusion" BinaryRef="UpgradeSupervisorCode"
                  ExeCommand="service end-upgrade --machine"
                  Execute="commit" Impersonate="no" Return="check" />
    <!-- Machine rollback: release the record and start every per-session
         instance of the restored registration that is not running. -->
    <CustomAction Id="RestartPreviousSupervisor" BinaryRef="UpgradeSupervisorCode"
                  ExeCommand="service start --machine"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <!-- The Target column is Formatted and an EXE action cannot read
         CustomActionData, so the folder is formatted into the command line when
         the script is written. The trailing "." keeps the property's final
         backslash from escaping the closing quote. [WIX_UPGRADE_DETECTED] names
         the related per-user products; each one's recorded install location is
         read through the MSI API, so a predecessor in a non-default folder is
         covered where it lives. -->
    <CustomAction Id="BeginUserUpgradeExclusion" BinaryRef="UpgradeSupervisorCode"
                  ExeCommand="service begin-upgrade --user &quot;[APPLICATIONFOLDER].&quot; --related &quot;[WIX_UPGRADE_DETECTED]&quot;"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="EndUserUpgradeExclusion" BinaryRef="UpgradeSupervisorCode"
                  ExeCommand="service end-upgrade --user"
                  Execute="commit" Impersonate="yes" Return="check" />
    <!-- Per-user rollback: release the record and run each related product's
         own activation from its recorded folder, so the previous runtime
         answers again before the next sign-in: jobdw.exe with the runtime
         flag for 0.1.6 and 0.1.7, openabstractionsw.exe from 0.1.8. A failure is
         logged to installer-actions.txt and does not block the rollback. The
         related product is still registered when this runs, because the
         predecessor is removed only after InstallFinalize. -->
    <CustomAction Id="RestartPreviousUserSupervisor" BinaryRef="UpgradeSupervisorCode"
                  ExeCommand="service start --related &quot;[WIX_UPGRADE_DETECTED]&quot;"
                  Execute="rollback" Impersonate="yes" Return="ignore" />
    <!-- Fresh machine installs and repairs register the host inside the
         transaction, with the elevated token the SCM needs, and undo it on
         rollback. A machine upgrade does neither: the predecessor's own
         registration of the same shared service name is still live, and
         deleting it on rollback would take the previous version's host with
         it. -->
    <CustomAction Id="RegisterSupervisor" FileRef="openabstractions.exe" ExeCommand="host register"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RollbackSupervisor" FileRef="openabstractions.exe" ExeCommand="host unregister"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <!-- 0.1.5 and 0.1.6 run their own `service uninstall` while being removed,
         and that removal happens after this version registered
         `OpenAbstractionsSupervisor`. Nothing deferred can run after
         RemoveExistingProducts, so a machine upgrade registers here, in the
         immediate sequence, after the predecessor's uninstall has finished.
         `host register` creates or rewrites the registration and its recovery
         policy. It reaches the SCM with the token that started msiexec;
         Return="check" reports a machine upgrade that could not register its
         host. -->
    <CustomAction Id="RegisterSupervisorAfterRemoval" FileRef="openabstractions.exe" ExeCommand="host register"
                  Execute="immediate" Return="check" />
    <!-- Delete the registration and its instances before the payload goes, for
         a real uninstall only: under UPGRADINGPRODUCTCODE a successor owns the
         shared service name from RegisterSupervisorAfterRemoval onwards. -->
    <CustomAction Id="UnregisterSupervisor" FileRef="openabstractions.exe" ExeCommand="host unregister"
                  Execute="deferred" Impersonate="no" Return="check" />
    <!-- Activation follows the committed install and the predecessor's removal.
         `start` refuses an elevated token before anything else, launches the
         windowless host detached and waits for readiness. When Restart Manager
         also restarts a registered host after the transaction, one of the two
         owns the endpoint and the other exits. -->
    <CustomAction Id="StartUserRuntime" FileRef="openabstractionsw.exe"
                  ExeCommand="start --require-unelevated"
                  Execute="immediate" Impersonate="yes" Return="check" />
    <!-- ALLUSERS=2 with MSIINSTALLPERUSER=1 resolves per-user for every token,
         including a full administrator or a deployment tool running as SYSTEM.
         Per-user activation refuses that token after InstallFinalize. This
         refusal runs under the same condition before costing, so nothing is
         copied or registered, and names both remedies. Selecting machine scope
         here instead would be a scope change nobody asked for. -->
    <CustomAction Id="RefuseElevatedPerUserInstall"
                  Error="Abstraction cannot install for your account from an elevated administrator session, because its runtime does not start with administrator rights. Run the installer without administrator rights to install for your account, or pass ALLUSERS=1 to install for everyone." />

    <InstallExecuteSequence>
      <Custom Action="RefuseElevatedPerUserInstall" Before="CostInitialize"
              Condition="AdminUser AND NOT ALLUSERS AND NOT (REMOVE=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="BeginMachineUpgradeExclusion" After="InstallInitialize"
              Condition="ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="EndMachineUpgradeExclusion" After="BeginMachineUpgradeExclusion"
              Condition="ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="RestartPreviousSupervisor" After="EndMachineUpgradeExclusion"
              Condition="ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="BeginUserUpgradeExclusion" After="RestartPreviousSupervisor"
              Condition="NOT ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="EndUserUpgradeExclusion" After="BeginUserUpgradeExclusion"
              Condition="NOT ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="RestartPreviousUserSupervisor" After="EndUserUpgradeExclusion"
              Condition="NOT ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <InstallExecute After="RestartPreviousUserSupervisor" />
      <Custom Action="UnregisterSupervisor" Before="RemoveFiles"
              Condition="ALLUSERS AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RollbackSupervisor" After="InstallFiles"
              Condition="ALLUSERS AND NOT (REMOVE=&quot;ALL&quot;) AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="RegisterSupervisor" After="RollbackSupervisor"
              Condition="ALLUSERS AND NOT (REMOVE=&quot;ALL&quot;) AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="RegisterSupervisorAfterRemoval" After="RemoveExistingProducts"
              Condition="ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="StartUserRuntime" After="RegisterSupervisorAfterRemoval"
              Condition="NOT ALLUSERS AND NOT (REMOVE=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <ComponentGroup Id="SupervisorService" Directory="APPLICATIONFOLDER">
      <Component Id="SupervisorServiceMarker" Guid="1C6E1D3F-6B0A-4D2E-9F3B-0A7E9C4D5B21"
                 Condition="ALLUSERS">
        <RegistryValue Root="HKLM" Key="Software\OpenAbstractions\Abstraction\Supervisor"
                       Name="service" Type="string" Value="OpenAbstractionsSupervisor" KeyPath="yes" />
        <RemoveRegistryKey Root="HKLM" Key="Software\OpenAbstractions\Abstraction\Supervisor"
                           Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>

    <!-- Per-user activation at sign-in. The windowless host starts the
         contained runtime, restarts it after failure, and registers for
         restart so an upgrade that ends it gets it back. A host that exits is
         started again by the next `openabstractions start`, SDK activation or
         sign-in. -->
    <ComponentGroup Id="LogonStart" Directory="StartupFolder">
      <Component Id="LogonStartShortcut" Guid="C84BB684-4B58-4B42-9B05-8F12DAFAABDE"
                 Condition="NOT ALLUSERS">
        <Shortcut Id="LogonStartFile" Name="Abstraction supervisor"
                  Description="Starts the OpenAbstractions runtime host"
                  Target="[#openabstractionsw.exe]" Arguments="serve host"
                  WorkingDirectory="ToolsFolder" />
        <RegistryValue Root="HKCU" Key="Software\OpenAbstractions\Abstraction\Supervisor"
                       Name="atLogon" Type="integer" Value="1" KeyPath="yes" />
        <RemoveRegistryKey Root="HKCU" Key="Software\OpenAbstractions\Abstraction\Supervisor"
                           Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>

    <!-- %ProgramData%\abstraction is where config.MachinePath() reads the file
         that answers for every account on the box, and C:\ProgramData grants
         BUILTIN\Users (CI)(WD,AD,WEA,WA): whoever creates that subdirectory
         first owns it and keeps full control of it. config refuses a machine
         file no administrator owns, so a squatted directory does not redirect
         anything — it makes the machine rung unreadable for everyone, including
         the administrator who installs afterwards. Creating it here, under the
         only scope that has an administrator, is what leaves that administrator
         somewhere to write.

         LockPermissions replaces the inherited ACL rather than adding to it,
         which is the whole point: the Users create-file ACE inherited from
         ProgramData must not survive into this directory. Users keep read and
         traverse, because every account has to be able to read the answer.

         ALLUSERS only. A per-user install has no administrator and must not
         leave a directory in a machine-wide location that it cannot protect. -->
    <ComponentGroup Id="MachineConfigFolderGroup" Directory="MachineConfigFolder">
      <Component Id="MachineConfigFolderAcl" Guid="C98ADFAD-1DEC-45F0-9FE5-C00345B3CFD3"
                 Condition="ALLUSERS">
        <CreateFolder>
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Users" GenericRead="yes" GenericExecute="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM" Key="Software\OpenAbstractions\Abstraction\MachineConfig"
                       Name="folder" Type="string" Value="[MachineConfigFolder]" KeyPath="yes" />
        <RemoveRegistryKey Root="HKLM" Key="Software\OpenAbstractions\Abstraction\MachineConfig"
                           Action="removeOnUninstall" />
        <!-- A machine upgrade creates upgrade-v1 here for its exclusion record
             and releases the record at commit, leaving the directory. Nothing
             else removes it, and while it exists this directory cannot be
             removed either: hosted run 35084640715 left
             %ProgramData%\abstraction\upgrade-v1 behind after uninstall. -->
        <RemoveFolder Id="RemoveMachineUpgradeFolder" Directory="MachineUpgradeFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- tools\, examples\ and dev\ are siblings under the install root, and only
         tools\ is on PATH: what a person runs and the source it runs are one
         file, and the programs they call are next door. -->
    <ComponentGroup Id="ExampleFiles">
      <Component Directory="ExamplesFolder">
        <File Id="examples.README.txt" Source="payload/examples/README.txt" KeyPath="yes" />
      </Component>
      <Component Directory="ExampleMachine">
        <File Id="example.machine.cmd" Source="payload/examples/what-this-machine-does/run.cmd" KeyPath="yes" />
      </Component>
      <Component Directory="ExampleLifecycle">
        <File Id="example.lifecycle.cmd" Source="payload/examples/job-lifecycle/run.cmd" KeyPath="yes" />
      </Component>
      <Component Directory="ExampleDownload">
        <File Id="example.download.cmd" Source="payload/examples/download-a-file/run.cmd" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Two components and not one because Environment@System is fixed when
         the package is built and the scope is chosen when it is installed.

         [ToolsFolder] and not [APPLICATIONFOLDER]tools\: the value is the
         resolved Directory row the executables are actually installed into, so
         moving them moves what goes on PATH and there is no second spelling of
         the path to keep in step. validate.py fails a PATH entry naming a
         directory the tools are not in. -->
    <ComponentGroup Id="PathEntry" Directory="APPLICATIONFOLDER">
      <Component Id="PathForMe" Guid="095FC050-F9AE-458B-9614-03B94D5FD51E"
                 Condition="NOT ALLUSERS">
        <RegistryValue Root="HKCU" Key="Software\OpenAbstractions\Abstraction\Path"
                       Name="scope" Type="string" Value="user" KeyPath="yes" />
        <Environment Id="PathUser" Name="PATH" Value="[ToolsFolder]"
                     Action="set" Part="last" System="no" Permanent="no" />
      </Component>
      <Component Id="PathForEveryone" Guid="447B9BFA-5714-4477-A5F8-2391D65E23B3"
                 Condition="ALLUSERS">
        <RegistryValue Root="HKLM" Key="Software\OpenAbstractions\Abstraction\Path"
                       Name="scope" Type="string" Value="machine" KeyPath="yes" />
        <Environment Id="PathMachine" Name="PATH" Value="[ToolsFolder]"
                     Action="set" Part="last" System="yes" Permanent="no" />
      </Component>
    </ComponentGroup>

    <?if $(var.Panel) = yes ?>
    <!-- The exe itself carries the icon: monitor/panel.rc packs
         monitor/icon/panel.ico at resource id 1 and go build links it in
         through monitor/rsrc_windows_*.syso (monitor/README.md). WiX reads
         that resource straight out of the staged binary rather than a
         second copy of the ico file, so ARPPRODUCTICON and both shortcuts
         below always show the same icon the exe does. -->
    <Icon Id="PanelIcon" SourceFile="payload/tools/Abstraction Panel.exe" />
    <Property Id="ARPPRODUCTICON" Value="PanelIcon" />
    <ComponentGroup Id="PanelFiles" Directory="ToolsFolder">
      <Component>
        <File Id="panel.exe" Name="Abstraction Panel.exe" Source="payload/tools/Abstraction Panel.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <ComponentGroup Id="PanelShortcut" Directory="AbstractionMenuFolder">
      <Component Id="PanelStartMenu" Guid="E5D9EA35-65C8-4930-9FC0-06120E9F39BE">
        <Shortcut Id="PanelShortcutFile" Name="Abstraction Panel"
                  Description="What this machine is doing with downloads, and what is holding the card"
                  Target="[#panel.exe]" WorkingDirectory="ToolsFolder" Icon="PanelIcon" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKMU" Key="Software\OpenAbstractions\Abstraction\Panel"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveRegistryKey Root="HKMU" Key="Software\OpenAbstractions\Abstraction\Panel"
                           Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>

    <!-- The Panel's own notification-area icon at sign-in, the same
         Startup-folder pattern LogonStart above uses for the runtime host.
         Per-user only: a per-user install has no administrator to register
         a machine-wide logon task, and a machine-scope install leaves this
         off for every account rather than start a tray icon nobody asked
         for in sessions that never open the Panel (installer/README.md). -->
    <ComponentGroup Id="PanelTrayLogonStart" Directory="StartupFolder">
      <Component Id="PanelTrayLogonStartShortcut" Guid="332A435E-CCA6-4D6B-B814-596735F40DE1"
                 Condition="NOT ALLUSERS">
        <Shortcut Id="PanelTrayLogonStartFile" Name="Abstraction Panel notifications"
                  Description="Shows a notification-area icon for pending OpenAbstractions questions"
                  Target="[#panel.exe]" Arguments="--tray" WorkingDirectory="ToolsFolder" Icon="PanelIcon" />
        <RegistryValue Root="HKCU" Key="Software\OpenAbstractions\Abstraction\Panel"
                       Name="trayAtLogon" Type="integer" Value="1" KeyPath="yes" />
        <RemoveRegistryKey Root="HKCU" Key="Software\OpenAbstractions\Abstraction\Panel"
                           Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>
    <?endif?>

    <ComponentGroup Id="DeveloperFiles">
      <Component Directory="DevFolder">
        <File Id="using.txt" Source="payload/dev/USING.txt" KeyPath="yes" />
      </Component>
      <?if $(var.Cpp) = yes ?>
      <Component Directory="DevIncludeDownload">
        <File Id="over_curl.hpp" Source="payload/dev/include/abstraction/download/over_curl.hpp" KeyPath="yes" />
      </Component>
      <?endif?>
    </ComponentGroup>

    <!-- The optional providers of VISION.md 2026-09-22. Each one is a separate
         process the runtime launches, carried by the one package as a feature
         a person ticks rather than by an installer of its own, because it
         versions with the runtime it serves.

         A provider feature installs its program into tools\, beside the
         runtime, and the declaration file that declares it into
         tools\declarations\. The runtime reads that directory at start and
         lists what it finds as declared by the installation. Removing the
         feature removes both components, so the declaration goes with the
         program it named and nothing is left declaring a program that is no
         longer there. An operator's own withdrawal is recorded in the
         runtime's state, so reinstalling the feature does not bring back a
         provider that person disabled.

         inventoryd reads model stores and writes in none of them, which is
         why LocalStores is on by default; the rights model draws that line
         and so does this feature's level. -->
    <?if $(var.LocalStores) = yes ?>
    <ComponentGroup Id="LocalStoresFiles">
      <Component Directory="ToolsFolder">
        <File Id="inventoryd.exe" Source="payload/tools/inventoryd.exe" KeyPath="yes" />
      </Component>
      <Component Directory="DeclarationsFolder">
        <File Id="declaration.local_stores.json" Source="payload/tools/declarations/local-stores.json" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <?endif?>

    <!-- Model host is a program the runtime launches, but not one this
         package can declare: the declaration names the objects and the
         llama.cpp engine path the person chooses, and `openabstractions
         models host` writes it after the program is installed. So, unlike
         LocalStores, this feature ships no declaration file — its marker is
         written the way the Panel's and the MCP gateway's are, and the same
         removal rule applies: taking the feature away takes modelhostd with
         it, and any declaration that command wrote afterward is the
         runtime's own state to keep or drop. -->
    <?if $(var.ModelHost) = yes ?>
    <ComponentGroup Id="ModelHostFiles" Directory="ToolsFolder">
      <Component>
        <File Id="modelhostd.exe" Source="payload/tools/modelhostd.exe" KeyPath="yes" />
      </Component>
      <Component Id="ModelHostMarker" Guid="13905645-2D4B-4ADA-89BF-0A12F6ABA2C2">
        <RegistryValue Root="HKMU" Key="Software\OpenAbstractions\Abstraction\ModelHost"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveRegistryKey Root="HKMU" Key="Software\OpenAbstractions\Abstraction\ModelHost"
                           Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>
    <?endif?>

    <!-- The MCP gateway is a program an assistant launches, not a provider the
         runtime launches, so it ships with no declaration file: nothing in the
         registry describes it and the runtime never starts it. Its authority
         is the one the Panel has — a named program installed beside the
         runtime, holding whatever an operator granted that exact path — and
         the marker below is written the way the Panel's is, so the same
         removal rule applies to both. The installation grants it nothing:
         mcp-gateway/README.md names the four rules an operator writes for the
         hosts and applications it should reach, and says not to copy the
         runtime's own broad grants onto it. -->
    <?if $(var.McpGateway) = yes ?>
    <ComponentGroup Id="McpGatewayFiles" Directory="ToolsFolder">
      <Component>
        <File Id="openabstractions_mcp.exe" Source="payload/tools/openabstractions-mcp.exe" KeyPath="yes" />
      </Component>
      <Component Id="McpGatewayMarker" Guid="0B0C2E74-9A5E-4F1C-8B24-3D6A1E5F7C08">
        <RegistryValue Root="HKMU" Key="Software\OpenAbstractions\Abstraction\McpGateway"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveRegistryKey Root="HKMU" Key="Software\OpenAbstractions\Abstraction\McpGateway"
                           Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>
    <?endif?>

    <Feature Id="Service" Level="1" AllowAbsent="no" AllowAdvertise="no"
             Title="Background supervisor"
             Description="Runs the OpenAbstractions runtime for applications, and keeps accepted work going after the calling program closes. For everyone, Windows starts the runtime host in each user's session at sign-in and restarts it after failure. For your account, installation starts the runtime host, a Startup shortcut starts it at sign-in, and the next command or application that needs it starts it again. The host restarts a runtime that fails, and upgrades restart it.">
      <ComponentGroupRef Id="ServiceFiles" />
      <ComponentGroupRef Id="SupervisorService" />
      <ComponentGroupRef Id="LogonStart" />
      <ComponentGroupRef Id="MachineConfigFolderGroup" />
    </Feature>

    <Feature Id="Tools" Level="1" AllowAdvertise="no"
             Title="Examples and the panel"
             Description="examples\ holds three that run openabstractions download, jobs and status against this install and need no checkout. The Abstraction Panel shows what the runtime serves.">
      <ComponentGroupRef Id="ExampleFiles" />
      <?if $(var.Panel) = yes ?>
      <ComponentGroupRef Id="PanelFiles" />
      <ComponentGroupRef Id="PanelShortcut" />
      <ComponentGroupRef Id="PanelTrayLogonStart" />
      <?endif?>

      <Feature Id="Path" Level="1" AllowAdvertise="no"
               Title="Add to PATH"
               Description="Puts the tools folder inside the install folder on PATH, so openabstractions runs in any shell. For everyone that is the machine PATH; just for you, your own. Untick this and they are still installed; you type the whole path.">
        <ComponentGroupRef Id="PathEntry" />
      </Feature>
    </Feature>

    <!-- Two descriptions because the files behind the first one are gated and
         the feature is not: a release build assembled out of published module
         versions carries USING.txt alone, under text promising headers and
         Python packages. -->
    <?if "$(var.NoCpp)" = "" ?><?define DeveloperText = "Headers and USING.txt, which names the Go module paths and the generated client packages, for building an application against these layers. Not needed to use the tools." ?>
    <?else?><?define DeveloperText = "USING.txt, which names the Go module paths and the generated client packages to install, for building an application against these layers.$(var.NoCpp) Not needed to use the tools." ?><?endif?>
    <Feature Id="Developer" Level="1000" AllowAdvertise="no"
             Title="Developer files"
             Description="$(var.DeveloperText)">
      <ComponentGroupRef Id="DeveloperFiles" />
    </Feature>

    <!-- Level 1 is ticked when the feature list opens and installed by a
         command line that names no ADDLOCAL. msiexec /i abstraction-x64.msi
         ADDLOCAL=Service,LocalStores installs exactly what it names, REMOVE=
         takes a feature away, and Change in Apps and features reopens this
         same list: nothing here is advertised and nothing is permanent, so a
         feature left out today is added later without reinstalling the
         product. -->
    <?if $(var.LocalStores) = yes ?>
    <Feature Id="LocalStores" Level="1" AllowAdvertise="no"
             Title="Local model stores"
             Description="Reads every model store on this machine — Ollama, Hugging Face, LM Studio, ComfyUI, FastFlowLM and Jan — and reports what each one holds to applications that ask the runtime. It reads listings, sizes and the programs' own index files. It writes in no store, which is why it is ticked to begin with. Untick it and the runtime lists only what each application tells it.">
      <ComponentGroupRef Id="LocalStoresFiles" />
    </Feature>
    <?endif?>

    <?if $(var.ModelHost) = yes ?>
    <Feature Id="ModelHost" Level="1000" AllowAdvertise="no"
             Title="Model host"
             Description="modelhostd, the provider that loads one model file this machine already holds with a llama-server this machine already has, and serves it through the runtime under a lease. Installing it starts nothing: openabstractions models host names the model and the engine path afterward, and writes the declaration that tells the runtime it exists.">
      <ComponentGroupRef Id="ModelHostFiles" />
    </Feature>
    <?endif?>

    <?if $(var.McpGateway) = yes ?>
    <Feature Id="McpGateway" Level="1000" AllowAdvertise="no"
             Title="MCP gateway"
             Description="openabstractions-mcp, a local stdio MCP server that gives an assistant six OA abilities: list applications, list models, one bounded completion, and submit, read or cancel durable image and video work. The runtime never starts it; an assistant does, by its absolute path. It holds nothing by being installed — grant it the applications and hosts it may reach with openabstractions rights.">
      <ComponentGroupRef Id="McpGatewayFiles" />
    </Feature>
    <?endif?>

    <!-- The NAS download provider's feature name, held and installing nothing.
         The NAS delegator is a tier inside the download layer
         (abstraction-download/go/nas): the runtime writes a job record into a
         share a jobd over there is watching, and there is no separate program
         on this machine to install. Level 0 keeps it out of the feature list
         and out of every install, so nobody ticks a box that does nothing.
         When that provider becomes a program, its components come here and its
         level becomes 1000 — off unless chosen, because it writes into a share
         and needs configuring. -->
    <Feature Id="NasDownload" Level="0" Display="0" AllowAdvertise="no"
             Title="NAS downloads"
             Description="Reserved. The NAS delegator ships inside the runtime today and installs no program of its own." />

    <ui:WixUI Id="WixUI_Advanced" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

  </Package>
</Wix>
