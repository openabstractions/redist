<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Abstraction"
           Manufacturer="Open Abstractions"
           Version="$(var.Version)"
           UpgradeCode="CEEF6550-5E44-4E83-8E18-A855C9D941CA"
           Scope="perUserOrMachine"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="Downloads that survive the program that started them" />

    <!-- The predecessor is removed after this installation is committed.
         Inside the transaction, a failure rolls the removal back, and an
         unelevated per-user rollback is denied the HKLM registration it would
         have to rewrite: the predecessor came back as files with no product
         registration, no Apps and features entry and no way to restart it
         (feedback/windows-per-user-upgrade-rollback-registration.md). After
         InstallFinalize the predecessor is untouched until this version is
         committed, so any failure before that leaves the previous version
         installed, registered and runnable — the owner's ruling of
         2026-09-16. The price is a second transaction: if the predecessor's
         own uninstall fails, both products stay installed
         (https://learn.microsoft.com/en-us/windows/win32/msi/removeexistingproducts-action). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallFinalize"
                  DowngradeErrorMessage="A newer Abstraction is already installed. Remove it from Apps and features before installing this one." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/openabstractions" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <!-- The package stops its own supervisor, so the Restart Manager must not.
         It shuts applications down at InstallValidate, 1400, and every action
         here that records what it stopped runs at 1505 and later. Measured on
         a v0.1.6 predecessor: the Restart Manager ended the supervisor first,
         `service stop` found nothing to record, and the rollback restart had
         nothing to start, so a failed upgrade left no supervisor until the
         next sign-in (feedback/restart-manager-preempts-the-supervisor-stop.md).
         This is a package default and not a SetProperty: Windows Installer
         opens its Restart Manager session before the first sequenced action,
         and a value set Before="InstallValidate" arrives after the shutdown it
         was meant to prevent. Every path that replaces or removes a running
         file therefore has an action of its own below: StopPreviousSupervisor
         and StopPreviousUserSupervisor for upgrades, UnregisterSupervisor and
         StopUserSupervisorOnRemoval for uninstalls. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="MSIRMSHUTDOWN" Value="0" />
    <!-- AdminUser reports the installing token itself. Without this, Windows sets
         AdminUser wherever Privileged is set, including AlwaysInstallElevated for
         a standard user, whose per-user activation works. -->
    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />

    <!-- A build that was not handed a source drops the files it would have
         carried, and every one of those drops is silent: build.py prints a
         note, the package says nothing, and a person reads feature text
         written for a package that has more in it. That is the per-user
         fallback one layer down — an artefact quietly doing less than it
         promised — so each gate turns the same variable into a sentence a
         person reads in Apps and features. An incomplete package may ship;
         one that does not say it is incomplete may not. -->
    <?if $(var.Panel) = yes ?><?define NoPanel = "" ?>
    <?else?><?define NoPanel = " The Abstraction Panel, the graphical front end, is not in it." ?><?endif?>
    <?if $(var.Dev) = yes ?><?define NoDev = "" ?>
    <?else?><?define NoDev = " The Python packages are not in it; they are on their own registry." ?><?endif?>
    <?if $(var.Cpp) = yes ?><?define NoCpp = "" ?>
    <?else?><?define NoCpp = " The C++ header is not in it; no module carries it." ?><?endif?>
    <?define Absent = "$(var.NoPanel)$(var.NoDev)$(var.NoCpp)" ?>
    <?if $(var.Absent) = "" ?>
    <Property Id="ARPCOMMENTS" Value="Downloads that survive the program that started them." />
    <?else?>
    <Property Id="ARPCOMMENTS" Value="This build is incomplete and says so.$(var.Absent)" />
    <?endif?>
    <Property Id="ApplicationFolderName" Value="OpenAbstractions" />
    <Property Id="WixAppFolder" Value="WixPerUserFolder" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[APPLICATIONFOLDER]" After="CostFinalize" />

    <!-- WixUI_Advanced defaults these to LocalAppData\Apps and to the 32-bit
         Program Files. Programs\ is where a per-user application goes on a
         modern Windows, and an x64 package under Program Files (x86) is a lie
         about what is inside it.

         ProgramFiles64Folder and not ProgramFiles6432Folder: the 6432 spelling
         is resolved by the compiler where a Directory is declared and means
         nothing inside a property value, where it expands to the empty string
         and leaves a bare relative folder name. Both architectures this
         package is built for are 64-bit. -->
    <SetProperty Action="AbstractionPerUserFolder" Id="WixPerUserFolder"
                 Value="[LocalAppDataFolder]Programs\[ApplicationFolderName]"
                 After="WixSetDefaultPerUserFolder" Sequence="both" />
    <SetProperty Action="AbstractionPerMachineFolder" Id="WixPerMachineFolder"
                 Value="[ProgramFiles64Folder][ApplicationFolderName]"
                 After="WixSetDefaultPerMachineFolder" Sequence="both" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="APPLICATIONFOLDER" Name="OpenAbstractions">
          <Directory Id="ToolsFolder" Name="tools" />
          <Directory Id="ExamplesFolder" Name="examples">
            <Directory Id="ExampleMachine" Name="what-this-machine-does" />
            <Directory Id="ExampleLifecycle" Name="job-lifecycle" />
            <Directory Id="ExampleDownload" Name="download-a-file" />
          </Directory>
          <Directory Id="DevFolder" Name="dev">
            <Directory Id="DevPython" Name="python">
              <Directory Id="DevPythonJob" Name="job" />
              <Directory Id="DevPythonDownload" Name="download" />
            </Directory>
            <Directory Id="DevInclude" Name="include">
              <Directory Id="DevIncludeAbstraction" Name="abstraction">
                <Directory Id="DevIncludeDownload" Name="download" />
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AbstractionMenuFolder" Name="Abstraction" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="MachineConfigFolder" Name="abstraction" />
    </StandardDirectory>

    <StandardDirectory Id="StartupFolder" />

    <!-- jobd.exe is in tools\ with dl and jobctl, and on PATH with them, because
         its own package comment calls it "the console program a person types
         at": `jobd status` is what the what-this-machine-does example runs and
         `jobd start` is what a person runs. The posix package has put all three
         in ~/.local/bin since it existed, and two packages disagreeing about
         where a tool lives is the same defect as one of them being wrong.

         Nothing about the registration depends on the folder: the custom
         actions below reach the file through the File table by Id, and the
         service's ImagePath is written by jobd from its own os.Executable(). -->
    <ComponentGroup Id="ServiceFiles">
      <Component Directory="ToolsFolder">
        <File Id="openabstractions.exe" Source="payload/tools/openabstractions.exe" KeyPath="yes" />
      </Component>
      <Component Directory="ToolsFolder">
        <File Id="jobd.exe" Source="payload/tools/jobd.exe" KeyPath="yes" />
      </Component>
      <Component Directory="ToolsFolder">
        <File Id="jobdw.exe" Source="payload/tools/jobdw.exe" KeyPath="yes" />
      </Component>
      <Component Id="RegistryRoot" Directory="APPLICATIONFOLDER"
                 Guid="8821E881-5E73-465E-904E-EF7FC1223A5C">
        <RegistryValue Root="HKMU" Key="Software\OpenAbstractions\Abstraction"
                       Name="version" Type="string" Value="$(var.Version)" KeyPath="yes" />
        <RemoveRegistryKey Root="HKMU" Key="Software\OpenAbstractions" Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>

    <!-- Registering the supervisor is a machine-scope act, because the only
         thing that supervises a process on Windows is the SCM and reaching it
         needs an administrator token. `sc create ... type= userown` gives a
         template the operating system clones into every interactive session as
         `<name>_<luid>`, running as that person with no password stored, and
         restarts when it dies — measured on Windows 11, and
         settled by the owner's own run of it, VISION.md 2026-09-10 "Host S is
         unnecessary".

         WiX cannot say it. ServiceInstall/@Type takes 'ownProcess,shareProcess'
         and nothing else, so the registration is a deferred custom action
         running the installed jobd.exe, which knows its own path, its own
         recovery policy and — the part sc.exe cannot express — how to find and
         delete the per-session instances that outlive the template.

         Every one of these is conditioned on ALLUSERS. A per-user install has
         no administrator token, and an action that needs one there is the 1603
         the logon schtasks returned. -->
    <!-- Execute incoming shutdown code before any file is replaced. The early
         InstallExecute flushes these deferred actions alone, ahead of
         RemoveFiles and InstallFiles, so no predecessor process holds a file
         this package is about to overwrite. -->
    <Binary Id="UpgradeSupervisorCode" SourceFile="payload/tools/jobd.exe" />
    <!-- Upgrade exclusion. Before a stop, the incoming jobd records the folders
         being replaced and this installer process; every activation path of
         those folders refuses while the installer lives. The commit action
         releases it. The rollback action releases it and restarts exactly what
         the stop recorded. Order in the early script: begin, commit release,
         rollback restart, stop. Rollback runs in reverse, so the record is
         released and its processes restarted after the files are back.

         The window now covers the file replacement and ends at commit. The
         predecessor's own removal runs after that, in its own transaction,
         with nothing of the predecessor running: its processes were ended by
         the stop, its per-user activation is a Startup shortcut that runs at
         sign-in, and its machine service was stopped and is not restarted. -->

    <CustomAction Id="BeginMachineUpgradeExclusion" BinaryRef="UpgradeSupervisorCode"
                  ExeCommand="service begin-upgrade --machine &quot;[APPLICATIONFOLDER].&quot; --related &quot;[WIX_UPGRADE_DETECTED]&quot;"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="EndMachineUpgradeExclusion" BinaryRef="UpgradeSupervisorCode"
                  ExeCommand="service end-upgrade --machine"
                  Execute="commit" Impersonate="no" Return="check" />
    <CustomAction Id="RestartPreviousSupervisor" BinaryRef="UpgradeSupervisorCode"
                  ExeCommand="service start --machine"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="StopPreviousSupervisor" BinaryRef="UpgradeSupervisorCode" ExeCommand="service stop"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="BeginUserUpgradeExclusion" BinaryRef="UpgradeSupervisorCode"
                  ExeCommand="service begin-upgrade --user &quot;[APPLICATIONFOLDER].&quot; --related &quot;[WIX_UPGRADE_DETECTED]&quot;"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="EndUserUpgradeExclusion" BinaryRef="UpgradeSupervisorCode"
                  ExeCommand="service end-upgrade --user"
                  Execute="commit" Impersonate="yes" Return="check" />
    <!-- A per-user predecessor is a process of the installing account, and a
         0.1.5 supervisor has no Restart Manager shutdown window. The installing
         user's token ends only its own processes under the upgraded folder.
         The Target column is Formatted and an EXE action cannot read
         CustomActionData, so the folder is formatted into the command line when
         the script is written. The trailing "." keeps the property's final
         backslash from escaping the closing quote. [WIX_UPGRADE_DETECTED] names
         the related per-user products; jobd reads each one's recorded install
         location through the MSI API, so a predecessor in a non-default folder
         is stopped where it lives. -->
    <CustomAction Id="StopPreviousUserSupervisor" BinaryRef="UpgradeSupervisorCode"
                  ExeCommand="service stop --user &quot;[APPLICATIONFOLDER].&quot; --related &quot;[WIX_UPGRADE_DETECTED]&quot;"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <!-- Removal has to end the supervisor too, now that the Restart Manager is
         not there to do it: its files are about to be deleted and it holds its
         own image. It names no related products, because a removal has no
         predecessor: the folder being removed is the whole scope. Narrowed to
         a real uninstall:
         under UPGRADINGPRODUCTCODE a successor is removing this product, it
         already stopped this supervisor at 1508, and the folder is its own. -->
    <CustomAction Id="StopUserSupervisorOnRemoval" BinaryRef="UpgradeSupervisorCode"
                  ExeCommand="service stop --user &quot;[APPLICATIONFOLDER].&quot;"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <!-- A failed upgrade leaves the old product installed and its supervisor
         stopped. This rollback action runs each related product's own Startup
         activation from its recorded folder, so the old supervisor answers
         again before the next sign-in. Scheduled before the stop, the script
         holds it whenever the stop has run. A restart failure is logged and
         does not block the rollback. With the removal after InstallFinalize
         the related product is still registered when this runs, so the start
         reads its version and install location through the MSI API instead of
         answering MsiGetProductInfoExW 1608. -->
    <CustomAction Id="RestartPreviousUserSupervisor" BinaryRef="UpgradeSupervisorCode"
                  ExeCommand="service start --related &quot;[WIX_UPGRADE_DETECTED]&quot;"
                  Execute="rollback" Impersonate="yes" Return="ignore" />
    <!-- Fresh machine installs and repairs register the supervisor inside the
         transaction, with the elevated token the SCM needs, and undo it on
         rollback. A machine upgrade does neither: the predecessor's own
         registration of the same shared service name is still live, and
         deleting it on rollback would take the previous version's supervisor
         with it — the thing a failed upgrade must leave working. -->
    <CustomAction Id="RegisterSupervisor" FileRef="jobd.exe" ExeCommand="service install --runtime"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RollbackSupervisor" FileRef="jobd.exe" ExeCommand="service uninstall"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <!-- The shared service name is the one thing a late removal cannot leave
         alone. 0.1.5 and 0.1.6 run their own `service uninstall` while being
         removed, and that removal now happens after this version would have
         registered `OpenAbstractionsSupervisor`, so the predecessor deletes
         the successor's service. Nothing deferred can run after
         RemoveExistingProducts — the execution script is committed at
         InstallFinalize — so a machine upgrade registers here instead, in the
         immediate sequence, after the predecessor's uninstall has finished.
         `service install` creates or rewrites the registration and its
         recovery policy, so running it once at the end is the whole
         registration for an upgrade. It reaches the SCM with the token that
         started msiexec; Return="check" reports a machine upgrade that could
         not register its supervisor rather than leaving one that installed
         the programs and nothing that runs them. -->
    <CustomAction Id="RegisterSupervisorAfterRemoval" FileRef="jobd.exe" ExeCommand="service install --runtime"
                  Execute="immediate" Return="check" />
    <!-- Preserve the payload if supervisor shutdown cannot be confirmed. The
         removal half is scoped to a real uninstall: under UPGRADINGPRODUCTCODE
         this product is being removed by a successor that has already stopped
         this supervisor and owns the shared service name from
         RegisterSupervisorAfterRemoval onwards. Deleting it there is what
         0.1.5 does to us. -->
    <CustomAction Id="UnregisterSupervisor" FileRef="jobd.exe" ExeCommand="service uninstall"
                  Execute="deferred" Impersonate="no" Return="check" />
    <!-- Activation follows the committed install and the predecessor's removal.
         A failure reports an error with installed files retained; it cannot
         promise transaction rollback. Starting before the removal would run
         the new runtime out of a folder the predecessor's uninstall is still
         accounting for. The executable checks its process token before any
         start/bus lookup. -->
    <CustomAction Id="StartUserRuntime" FileRef="jobdw.exe"
                  ExeCommand="start --runtime --require-unelevated"
                  Execute="immediate" Impersonate="yes" Return="check" />
    <!-- ALLUSERS=2 with MSIINSTALLPERUSER=1 resolves per-user for every token,
         including a full administrator or a deployment tool running as SYSTEM.
         Per-user activation refuses that token after InstallFinalize. This
         refusal runs under the same condition before costing, so nothing is
         copied or registered, and names both remedies. Selecting machine scope
         here instead would be a scope change nobody asked for. -->
    <CustomAction Id="RefuseElevatedPerUserInstall"
                  Error="Abstraction cannot install for your account from an elevated administrator session, because its runtime does not start with administrator rights. Run the installer without administrator rights to install for your account, or pass ALLUSERS=1 to install for everyone." />

    <InstallExecuteSequence>
      <Custom Action="RefuseElevatedPerUserInstall" Before="CostInitialize"
              Condition="AdminUser AND NOT ALLUSERS AND NOT (REMOVE=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="BeginMachineUpgradeExclusion" After="InstallInitialize"
              Condition="ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="EndMachineUpgradeExclusion" After="BeginMachineUpgradeExclusion"
              Condition="ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="RestartPreviousSupervisor" After="EndMachineUpgradeExclusion"
              Condition="ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="StopPreviousSupervisor" After="RestartPreviousSupervisor"
              Condition="ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="BeginUserUpgradeExclusion" After="StopPreviousSupervisor"
              Condition="NOT ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="EndUserUpgradeExclusion" After="BeginUserUpgradeExclusion"
              Condition="NOT ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="RestartPreviousUserSupervisor" After="EndUserUpgradeExclusion"
              Condition="NOT ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="StopPreviousUserSupervisor" After="RestartPreviousUserSupervisor"
              Condition="NOT ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="StopUserSupervisorOnRemoval" After="StopPreviousUserSupervisor"
              Condition="NOT ALLUSERS AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <InstallExecute After="StopUserSupervisorOnRemoval" />
      <Custom Action="UnregisterSupervisor" Before="RemoveFiles"
              Condition="ALLUSERS AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RollbackSupervisor" After="InstallFiles"
              Condition="ALLUSERS AND NOT (REMOVE=&quot;ALL&quot;) AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="RegisterSupervisor" After="RollbackSupervisor"
              Condition="ALLUSERS AND NOT (REMOVE=&quot;ALL&quot;) AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="RegisterSupervisorAfterRemoval" After="RemoveExistingProducts"
              Condition="ALLUSERS AND WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="StartUserRuntime" After="RegisterSupervisorAfterRemoval"
              Condition="NOT ALLUSERS AND NOT (REMOVE=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <ComponentGroup Id="SupervisorService" Directory="APPLICATIONFOLDER">
      <Component Id="SupervisorServiceMarker" Guid="1C6E1D3F-6B0A-4D2E-9F3B-0A7E9C4D5B21"
                 Condition="ALLUSERS">
        <RegistryValue Root="HKLM" Key="Software\OpenAbstractions\Abstraction\Supervisor"
                       Name="service" Type="string" Value="OpenAbstractionsSupervisor" KeyPath="yes" />
        <RemoveRegistryKey Root="HKLM" Key="Software\OpenAbstractions\Abstraction\Supervisor"
                           Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>

    <!-- Per-user activation runs at sign-in. The windowless supervisor starts
         the contained sibling runtime and retains its download worker. Start
         checks logging/config availability even when a supervisor already
         answers. The shortcut supplies no recovery after the supervisor dies. -->
    <ComponentGroup Id="LogonStart" Directory="StartupFolder">
      <Component Id="LogonStartShortcut" Guid="C84BB684-4B58-4B42-9B05-8F12DAFAABDE"
                 Condition="NOT ALLUSERS">
        <Shortcut Id="LogonStartFile" Name="Abstraction supervisor"
                  Description="Starts the download supervisor and shared runtime"
                  Target="[#jobdw.exe]" Arguments="start --runtime"
                  WorkingDirectory="ToolsFolder" />
        <RegistryValue Root="HKCU" Key="Software\OpenAbstractions\Abstraction\Supervisor"
                       Name="atLogon" Type="integer" Value="1" KeyPath="yes" />
        <RemoveRegistryKey Root="HKCU" Key="Software\OpenAbstractions\Abstraction\Supervisor"
                           Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>

    <!-- %ProgramData%\abstraction is where config.MachinePath() reads the file
         that answers for every account on the box, and C:\ProgramData grants
         BUILTIN\Users (CI)(WD,AD,WEA,WA): whoever creates that subdirectory
         first owns it and keeps full control of it. config refuses a machine
         file no administrator owns, so a squatted directory does not redirect
         anything — it makes the machine rung unreadable for everyone, including
         the administrator who installs afterwards. Creating it here, under the
         only scope that has an administrator, is what leaves that administrator
         somewhere to write.

         LockPermissions replaces the inherited ACL rather than adding to it,
         which is the whole point: the Users create-file ACE inherited from
         ProgramData must not survive into this directory. Users keep read and
         traverse, because every account has to be able to read the answer.

         ALLUSERS only. A per-user install has no administrator and must not
         leave a directory in a machine-wide location that it cannot protect. -->
    <ComponentGroup Id="MachineConfigFolderGroup" Directory="MachineConfigFolder">
      <Component Id="MachineConfigFolderAcl" Guid="C98ADFAD-1DEC-45F0-9FE5-C00345B3CFD3"
                 Condition="ALLUSERS">
        <CreateFolder>
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Users" GenericRead="yes" GenericExecute="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM" Key="Software\OpenAbstractions\Abstraction\MachineConfig"
                       Name="folder" Type="string" Value="[MachineConfigFolder]" KeyPath="yes" />
        <RemoveRegistryKey Root="HKLM" Key="Software\OpenAbstractions\Abstraction\MachineConfig"
                           Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ToolFiles" Directory="ToolsFolder">
      <Component>
        <File Id="dl.exe" Source="payload/tools/dl.exe" KeyPath="yes" />
      </Component>
      <Component>
        <File Id="jobctl.exe" Source="payload/tools/jobctl.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- tools\, examples\ and dev\ are siblings under the install root, and only
         tools\ is on PATH: what a person runs and the source it runs are one
         file, and the programs they call are next door. -->
    <ComponentGroup Id="ExampleFiles">
      <Component Directory="ExamplesFolder">
        <File Id="examples.README.txt" Source="payload/examples/README.txt" KeyPath="yes" />
      </Component>
      <Component Directory="ExampleMachine">
        <File Id="example.machine.cmd" Source="payload/examples/what-this-machine-does/run.cmd" KeyPath="yes" />
      </Component>
      <Component Directory="ExampleLifecycle">
        <File Id="example.lifecycle.cmd" Source="payload/examples/job-lifecycle/run.cmd" KeyPath="yes" />
      </Component>
      <Component Directory="ExampleDownload">
        <File Id="example.download.cmd" Source="payload/examples/download-a-file/run.cmd" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Two components and not one because Environment@System is fixed when
         the package is built and the scope is chosen when it is installed.

         [ToolsFolder] and not [APPLICATIONFOLDER]tools\: the value is the
         resolved Directory row the executables are actually installed into, so
         moving them moves what goes on PATH and there is no second spelling of
         the path to keep in step. validate.py fails a PATH entry naming a
         directory the tools are not in. -->
    <ComponentGroup Id="PathEntry" Directory="APPLICATIONFOLDER">
      <Component Id="PathForMe" Guid="095FC050-F9AE-458B-9614-03B94D5FD51E"
                 Condition="NOT ALLUSERS">
        <RegistryValue Root="HKCU" Key="Software\OpenAbstractions\Abstraction\Path"
                       Name="scope" Type="string" Value="user" KeyPath="yes" />
        <Environment Id="PathUser" Name="PATH" Value="[ToolsFolder]"
                     Action="set" Part="last" System="no" Permanent="no" />
      </Component>
      <Component Id="PathForEveryone" Guid="447B9BFA-5714-4477-A5F8-2391D65E23B3"
                 Condition="ALLUSERS">
        <RegistryValue Root="HKLM" Key="Software\OpenAbstractions\Abstraction\Path"
                       Name="scope" Type="string" Value="machine" KeyPath="yes" />
        <Environment Id="PathMachine" Name="PATH" Value="[ToolsFolder]"
                     Action="set" Part="last" System="yes" Permanent="no" />
      </Component>
    </ComponentGroup>

    <?if $(var.Panel) = yes ?>
    <ComponentGroup Id="PanelFiles" Directory="ToolsFolder">
      <Component>
        <File Id="panel.exe" Name="Abstraction Panel.exe" Source="payload/tools/Abstraction Panel.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <ComponentGroup Id="PanelShortcut" Directory="AbstractionMenuFolder">
      <Component Id="PanelStartMenu" Guid="E5D9EA35-65C8-4930-9FC0-06120E9F39BE">
        <Shortcut Id="PanelShortcutFile" Name="Abstraction Panel"
                  Description="What this machine is doing with downloads, and what is holding the card"
                  Target="[#panel.exe]" WorkingDirectory="ToolsFolder" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKMU" Key="Software\OpenAbstractions\Abstraction\Panel"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveRegistryKey Root="HKMU" Key="Software\OpenAbstractions\Abstraction\Panel"
                           Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>
    <?endif?>

    <ComponentGroup Id="DeveloperFiles">
      <Component Directory="DevFolder">
        <File Id="using.txt" Source="payload/dev/USING.txt" KeyPath="yes" />
      </Component>
      <?if $(var.Dev) = yes ?>
      <Component Directory="DevPythonJob">
        <File Id="abstraction_job.py" Source="payload/dev/python/job/abstraction_job.py" KeyPath="yes" />
      </Component>
      <Component Directory="DevPythonJob">
        <File Id="job.pyproject.toml" Name="pyproject.toml" Source="payload/dev/python/job/pyproject.toml" KeyPath="yes" />
      </Component>
      <Component Directory="DevPythonDownload">
        <File Id="abstraction_download.py" Source="payload/dev/python/download/abstraction_download.py" KeyPath="yes" />
      </Component>
      <Component Directory="DevPythonDownload">
        <File Id="download.pyproject.toml" Name="pyproject.toml" Source="payload/dev/python/download/pyproject.toml" KeyPath="yes" />
      </Component>
      <?endif?>
      <?if $(var.Cpp) = yes ?>
      <Component Directory="DevIncludeDownload">
        <File Id="over_curl.hpp" Source="payload/dev/include/abstraction/download/over_curl.hpp" KeyPath="yes" />
      </Component>
      <?endif?>
    </ComponentGroup>

    <Feature Id="Service" Level="1" AllowAbsent="no" AllowAdvertise="no"
             Title="Background supervisor"
             Description="Finishes transfers after the calling program closes. For everyone, Windows starts the supervisor in each user's session at sign-in and restarts it after failure. For your account, installation starts the runtime and supervisor, and a Startup shortcut starts them at sign-in. A per-user supervisor that exits starts again at the next sign-in.">
      <ComponentGroupRef Id="ServiceFiles" />
      <ComponentGroupRef Id="SupervisorService" />
      <ComponentGroupRef Id="LogonStart" />
      <ComponentGroupRef Id="MachineConfigFolderGroup" />
    </Feature>

    <Feature Id="Tools" Level="1" AllowAdvertise="no"
             Title="Command-line tools and examples"
             Description="dl resumes a download from what it proved and refuses corruption that curl -C - accepts. jobctl drives the job store from a shell. examples\ holds three that run against this install and need no checkout.">
      <ComponentGroupRef Id="ToolFiles" />
      <ComponentGroupRef Id="ExampleFiles" />
      <?if $(var.Panel) = yes ?>
      <ComponentGroupRef Id="PanelFiles" />
      <ComponentGroupRef Id="PanelShortcut" />
      <?endif?>

      <Feature Id="Path" Level="1" AllowAdvertise="no"
               Title="Add to PATH"
               Description="Puts the tools folder inside the install folder on PATH, so dl, jobctl and jobd run in any shell. For everyone that is the machine PATH; just for you, your own. Untick this and they are still installed; you type the whole path.">
        <ComponentGroupRef Id="PathEntry" />
      </Feature>
    </Feature>

    <!-- Two descriptions because the files behind the first one are gated and
         the feature is not: a release build assembled out of published module
         versions carries USING.txt alone, under text promising headers and
         Python packages. -->
    <?if "$(var.NoDev)$(var.NoCpp)" = "" ?><?define DeveloperText = "Headers, the Python packages and the Go module paths, for building an application against these layers. Not needed to use the tools." ?>
    <?else?><?define DeveloperText = "USING.txt, which names the Go module paths and the package names to install, for building an application against these layers.$(var.NoDev)$(var.NoCpp) Not needed to use the tools." ?><?endif?>
    <Feature Id="Developer" Level="1000" AllowAdvertise="no"
             Title="Developer files"
             Description="$(var.DeveloperText)">
      <ComponentGroupRef Id="DeveloperFiles" />
    </Feature>

    <ui:WixUI Id="WixUI_Advanced" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

  </Package>
</Wix>
